{
  "name": "codemirror-lang-ada",
  "version": "0.1.1",
  "description": "Ada language support for CodeMirror 6",
  "scripts": {
    "build": "lezer-generator src/ada.grammar -o src/parser.ts && rollup -c",
    "build-debug": "lezer-generator src/ada.grammar -o src/parser.ts --names && rollup -c",
    "prepare": "npm run build",
    "test": "mocha test/test.js"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@codemirror/language": "^6.10.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/lr": "^1.4.0",
    "codemirror-lang-ada": "^0.1.0"
  },
  "devDependencies": {
    "@lezer/common": "^1.2.0",
    "@lezer/generator": "^1.7.0",
    "@rollup/plugin-node-resolve": "^15.2.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "mocha": "^10.4.0",
    "rollup": "^4.17.0",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0"
  },
  "keywords": [
    "codemirror",
    "codemirror6",
    "ada",
    "language",
    "syntax",
    "highlighting",
    "lezer"
  ],
  "author": "CB-X2-Jun <cbx2jun@cc.cc>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CB-X2-Jun/codemirror-lang-ada.git"
  },
  "bugs": {
    "url": "https://github.com/CB-X2-Jun/codemirror-lang-ada/issues"
  },
  "homepage": "https://github.com/CB-X2-Jun/codemirror-lang-ada#readme"
}
