@precedence {
  keyword @cut,
  char @cut,
  at @cut
}

@top Program { Statement* }

Statement {
  Keyword |
  Identifier |
  Number |
  String |
  Char |
  Attribute |
  Operator |
  Punctuation
}

@tokens {
  Keyword {
    ($[aA] $[bB] $[oO] $[rR] $[tT]) |
    ($[aA] $[bB] $[sS]) |
    ($[aA] $[bB] $[sS] $[tT] $[rR] $[aA] $[cC] $[tT]) |
    ($[aA] $[cC] $[cC] $[eE] $[pP] $[tT]) |
    ($[aA] $[cC] $[cC] $[eE] $[sS] $[sS]) |
    ($[aA] $[lL] $[iI] $[aA] $[sS] $[eE] $[dD]) |
    ($[aA] $[lL] $[lL]) |
    ($[aA] $[nN] $[dD]) |
    ($[aA] $[rR] $[rR] $[aA] $[yY]) |
    ($[aA] $[tT]) |
    ($[bB] $[eE] $[gG] $[iI] $[nN]) |
    ($[bB] $[oO] $[dD] $[yY]) |
    ($[cC] $[aA] $[sS] $[eE]) |
    ($[cC] $[oO] $[nN] $[sS] $[tT] $[aA] $[nN] $[tT]) |
    ($[dD] $[eE] $[cC] $[lL] $[aA] $[rR] $[eE]) |
    ($[dD] $[eE] $[lL] $[aA] $[yY]) |
    ($[dD] $[eE] $[lL] $[tT] $[aA]) |
    ($[dD] $[iI] $[gG] $[iI] $[tT] $[sS]) |
    ($[dD] $[oO]) |
    ($[eE] $[lL] $[sS] $[eE]) |
    ($[eE] $[lL] $[sS] $[iI] $[fF]) |
    ($[eE] $[nN] $[dD]) |
    ($[eE] $[nN] $[tT] $[rR] $[yY]) |
    ($[eE] $[xX] $[cC] $[eE] $[pP] $[tT] $[iI] $[oO] $[nN]) |
    ($[eE] $[xX] $[iI] $[tT]) |
    ($[fF] $[oO] $[rR]) |
    ($[fF] $[uU] $[nN] $[cC] $[tT] $[iI] $[oO] $[nN]) |
    ($[gG] $[eE] $[nN] $[eE] $[rR] $[iI] $[cC]) |
    ($[gG] $[oO] $[tT] $[oO]) |
    ($[iI] $[fF]) |
    ($[iI] $[nN]) |
    ($[iI] $[nN] $[tT] $[eE] $[rR] $[fF] $[aA] $[cC] $[eE]) |
    ($[iI] $[sS]) |
    ($[lL] $[iI] $[mM] $[iI] $[tT] $[eE] $[dD]) |
    ($[lL] $[oO] $[oO] $[pP]) |
    ($[mM] $[oO] $[dD]) |
    ($[nN] $[eE] $[wW]) |
    ($[nN] $[oO] $[tT]) |
    ($[nN] $[uU] $[lL] $[lL]) |
    ($[oO] $[fF]) |
    ($[oO] $[rR]) |
    ($[oO] $[tT] $[hH] $[eE] $[rR] $[sS]) |
    ($[oO] $[uU] $[tT]) |
    ($[oO] $[vV] $[eE] $[rR] $[rR] $[iI] $[dD] $[iI] $[nN] $[gG]) |
    ($[pP] $[aA] $[cC] $[kK] $[aA] $[gG] $[eE]) |
    ($[pP] $[rR] $[aA] $[gG] $[mM] $[aA]) |
    ($[pP] $[rR] $[iI] $[vV] $[aA] $[tT] $[eE]) |
    ($[pP] $[rR] $[oO] $[cC] $[eE] $[dD] $[uU] $[rR] $[eE]) |
    ($[pP] $[rR] $[oO] $[tT] $[eE] $[cC] $[tT] $[eE] $[dD]) |
    ($[rR] $[aA] $[iI] $[sS] $[eE]) |
    ($[rR] $[aA] $[nN] $[gG] $[eE]) |
    ($[rR] $[eE] $[cC] $[oO] $[rR] $[dD]) |
    ($[rR] $[eE] $[mM]) |
    ($[rR] $[eE] $[nN] $[aA] $[mM] $[eE] $[sS]) |
    ($[rR] $[eE] $[qQ] $[uU] $[eE] $[uU] $[eE]) |
    ($[rR] $[eE] $[tT] $[uU] $[rR] $[nN]) |
    ($[rR] $[eE] $[vV] $[eE] $[rR] $[sS] $[eE]) |
    ($[sS] $[eE] $[lL] $[eE] $[cC] $[tT]) |
    ($[sS] $[eE] $[pP] $[aA] $[rR] $[aA] $[tT] $[eE]) |
    ($[sS] $[oO] $[mM] $[eE]) |
    ($[sS] $[uU] $[bB] $[tT] $[yY] $[pP] $[eE]) |
    ($[sS] $[yY] $[nN] $[cC] $[hH] $[rR] $[oO] $[nN] $[iI] $[zZ] $[eE] $[dD]) |
    ($[tT] $[aA] $[gG] $[gG] $[eE] $[dD]) |
    ($[tT] $[aA] $[sS] $[kK]) |
    ($[tT] $[eE] $[rR] $[mM] $[iI] $[nN] $[aA] $[tT] $[eE]) |
    ($[tT] $[hH] $[eE] $[nN]) |
    ($[tT] $[yY] $[pP] $[eE]) |
    ($[uU] $[nN] $[tT] $[iI] $[lL]) |
    ($[uU] $[sS] $[eE]) |
    ($[wW] $[hH] $[eE] $[nN]) |
    ($[wW] $[hH] $[iI] $[lL] $[eE]) |
    ($[wW] $[iI] $[tT] $[hH]) |
    ($[xX] $[oO] $[rR])
  }

  Identifier { $[a-zA-Z] $[a-zA-Z0-9_]* }

  Number {
    $[0-9] $[0-9_]*
    ("." $[0-9_]*)?
    (("e" | "E") ("+" | "-")? $[0-9_]+)?
  }

  String { "\"" (![\"\n] | "\"\"")* "\"" }

  Char { "'" ![\'\n] "'" }

  Attribute { "'" $[a-zA-Z] $[a-zA-Z0-9_]* }

  Operator {
    "+" | "-" | "*" | "/" | "**" | "=" | "/=" | "<" | "<=" | ">" | ">=" |
    ":=" | "=>" | ".." | "<>" | "&" | "|" | "<<" | ">>"
  }

  Punctuation {
    "," | ";" | ":" | "(" | ")" | "[" | "]" | "."
  }

  LineComment { "--" ![\n]* }

  whitespace { $[ \t\n\r]+ }

  @precedence { LineComment, Operator }
  @precedence { Keyword, Identifier }
  @precedence { Char, Attribute }
  @precedence { Number, Operator }
  @precedence { Operator, Punctuation }
}

@skip { whitespace | LineComment }
